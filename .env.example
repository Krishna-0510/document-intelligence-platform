# Copy this file to .env and fill in real values locally.
# NEVER commit the real .env file — it is already in .gitignore.
# In deployment (Render/Railway), set these as platform environment
# variables instead of a file.

APP_NAME="Document Intelligence Platform"
ENVIRONMENT=development
DEBUG=true

# Database — SQLite locally; swap for Postgres/MySQL URL in production
DATABASE_URL=sqlite:///./document_intelligence.db

# LLM provider used for field/table extraction
LLM_PROVIDER=openai
LLM_API_KEY=your-llm-api-key-here
LLM_MODEL=gpt-4o-mini

# OCR — only needed if using a hosted OCR provider instead of local Tesseract
OCR_ENGINE=tesseract
OCR_API_KEY=

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
